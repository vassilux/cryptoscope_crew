
# Langue / fuseau
LANG=fr
TZ=Europe/Paris

# Marché
PAIRS=BTC/USDC, ETH/USDC, XRP/USDC, ADA/USDC
TIMEFRAME=1d
LOOKBACK=450

# Sortie
OUTPUT_DIR=reports

# LLM
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4o-mini

OPENAI_MODEL_RESEARCHER=gpt-5
OPENAI_MODEL_TECHNICIAN=gpt-4o-mini
OPENAI_MODEL_ANALYST=gpt-4o-mini


SERPER_API_KEY= 

# Exchange keys (only for private endpoints; not needed for public OHLCV)
BINANCE_KEY=
BINANCE_SECRET=

# General
DEFAULT_EXCHANGE=binance

CREWAI_TRACING_ENABLED=true
