
# Langue / fuseau
LANG=fr
TZ=Europe/Paris

# Marché
PAIRS=BTC/USDC, ETH/USDC, XRP/USDC, ADA/USDC, SOL/USDC
TIMEFRAME=1d
TIMEFRAMES=1d,4h,1h
LOOKBACK=450

# Sortie
OUTPUT_DIR=reports

# LLM
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4o-mini

OPENAI_MODEL_RESEARCHER=gpt-5
OPENAI_MODEL_TECHNICIAN=gpt-4o-mini
OPENAI_MODEL_ANALYST=gpt-4o-mini


SERPER_API_KEY= 

# Exchange keys (only for private endpoints; not needed for public OHLCV)
BINANCE_KEY=
BINANCE_SECRET=

# General
DEFAULT_EXCHANGE=binance

CREWAI_TRACING_ENABLED=true

# Kronos forecast (mode observation — n'influence pas les décisions)
KRONOS_ENABLED=1
KRONOS_TIMEFRAME=4h
KRONOS_PRED_LEN=24
KRONOS_LOOKBACK=400
KRONOS_SAMPLE_COUNT=1

MEMBIT_API_KEY=ta_clé_api_membit
